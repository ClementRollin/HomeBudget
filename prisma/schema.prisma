datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Family {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  inviteCode  String           @unique
  createdAt   DateTime         @default(now())
  users       User[]
  members     FamilyMember[]
  sheets      Sheet[]
  invitations Invitation[]
  assets      Asset[]
  debts       Debt[]
  goals       PatrimonialGoal[]
  fiscalConfig FiscalConfig?
}

model Invitation {
  id              String    @id @default(cuid())
  family          Family    @relation(fields: [familyId], references: [id])
  familyId        String
  codeHash        String
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
  usedAt          DateTime?
  usedByUserId    String?
  createdByUserId String?

  @@index([familyId])
  @@unique([familyId, codeHash])
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  family    Family   @relation(fields: [familyId], references: [id])
  familyId  String
  sheets    Sheet[]
  member    FamilyMember?
}

model FamilyMember {
  id          String   @id @default(cuid())
  family      Family   @relation(fields: [familyId], references: [id])
  familyId    String
  user        User?    @relation(fields: [userId], references: [id])
  userId      String?  @unique
  displayName String
  slug        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  salaries    Salary[]
  charges     Charge[]

  @@unique([familyId, slug])
}

model Sheet {
  id        String    @id @default(cuid())
  year      Int
  month     Int
  family    Family    @relation(fields: [familyId], references: [id])
  familyId  String
  owner     User?     @relation(fields: [ownerId], references: [id])
  ownerId   String?
  salaries  Salary[]
  charges   Charge[]
  budgets   Budget[]
  createdAt DateTime  @default(now())

  @@index([familyId, year, month])
}

model Salary {
  id       String  @id @default(cuid())
  sheet    Sheet   @relation(fields: [sheetId], references: [id])
  sheetId  String
  member   FamilyMember? @relation(fields: [memberId], references: [id])
  memberId String?
  encryptedLabel  String @default("")
  encryptedAmount String @default("")
  createdAt       DateTime @default(now())
}

model Charge {
  id       String        @id @default(cuid())
  sheet    Sheet         @relation(fields: [sheetId], references: [id])
  sheetId  String
  category ChargeCategory @default(FIXE_COMMUN)
  member   FamilyMember? @relation(fields: [memberId], references: [id])
  memberId String?
  debt     Debt?         @relation(fields: [debtId], references: [id], onDelete: SetNull)
  debtId   String?
  encryptedLabel  String @default("")
  encryptedAmount String @default("")
  createdAt       DateTime @default(now())

  @@index([debtId])
}

model Budget {
  id       String  @id @default(cuid())
  sheet    Sheet   @relation(fields: [sheetId], references: [id])
  sheetId  String
  encryptedLabel  String @default("")
  encryptedAmount String @default("")
  createdAt       DateTime @default(now())
}

enum ChargeCategory {
  FIXE_COMMUN
  FIXE_INDIVIDUEL
  EXCEPTIONNEL_COMMUN
  EXCEPTIONNEL_INDIVIDUEL
}

enum AssetType {
  PEA
  ASSURANCE_VIE
  PER
  LIVRET
  SCPI
  IMMOBILIER
  CRYPTO
  AUTRE
}

model Asset {
  id                     String        @id @default(cuid())
  family                 Family        @relation(fields: [familyId], references: [id])
  familyId               String
  type                   AssetType
  encryptedName          String
  encryptedCurrentValue  String
  encryptedTotalInvested String
  encryptedAnnualFee     String        @default("")
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  snapshots              AssetSnapshot[]

  @@index([familyId])
}

model FiscalConfig {
  id                        String   @id @default(cuid())
  family                    Family   @relation(fields: [familyId], references: [id])
  familyId                  String   @unique
  isCoupled                 Boolean  @default(false)
  encryptedPerContribYTD    String   @default("")
  updatedAt                 DateTime @updatedAt
}

model AssetSnapshot {
  id             String   @id @default(cuid())
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId        String
  year           Int
  month          Int
  encryptedValue String
  createdAt      DateTime @default(now())

  @@unique([assetId, year, month])
  @@index([assetId])
}

model Debt {
  id                      String    @id @default(cuid())
  family                  Family    @relation(fields: [familyId], references: [id])
  familyId                String
  encryptedLabel          String
  encryptedBalance        String
  encryptedRate           String
  encryptedMonthlyPayment String
  endDate                 DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  charges                 Charge[]

  @@index([familyId])
}

model PatrimonialGoal {
  id              String   @id @default(cuid())
  family          Family   @relation(fields: [familyId], references: [id])
  familyId        String
  encryptedLabel  String
  encryptedTarget String
  horizon         Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([familyId])
}
