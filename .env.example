# =============================================================================
# HomeBudget — Variables d'environnement requises
# Copier ce fichier en .env.local pour le développement local
# NE JAMAIS committer .env ou .env.local dans git
# =============================================================================

# --- Base de données (PostgreSQL) ---
# Connexion poolée via PgBouncer (Supabase) pour l'ORM
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:6543/postgres?pgbouncer=true"

# --- Authentification (Auth.js / NextAuth) ---
# Générer avec : openssl rand -base64 32
AUTH_SECRET="replace-with-strong-secret"
# URL publique de l'application (requis en production)
NEXTAUTH_URL="https://[VOTRE-DOMAINE]"

# --- Chiffrement des données sensibles (AES-256-GCM) ---
# Générer avec : openssl rand -base64 32
# CRITIQUE : perdre cette clé = perte de toutes les données chiffrées
ENCRYPTION_KEY="replace-with-32-bytes-base64-key"

# --- Invitations famille ---
# Poivre pour le hachage des codes d'invitation
# Générer avec : openssl rand -base64 32
INVITE_PEPPER="replace-with-pepper-secret"
# Durée de validité des invitations en jours (défaut : 7)
INVITE_EXPIRATION_DAYS="7"

# --- Stripe (paiements et abonnements) ---
# Clé secrète Stripe (sk_live_... en production, sk_test_... en dev)
STRIPE_SECRET_KEY="sk_test_..."
# Secret du webhook Stripe (obtenu dans le dashboard Stripe)
STRIPE_WEBHOOK_SECRET="whsec_..."
# ID du prix mensuel PRO (créer dans le dashboard Stripe)
STRIPE_PRICE_ID_PRO_MONTHLY="price_..."
# ID du prix annuel PRO (optionnel)
STRIPE_PRICE_ID_PRO_ANNUAL="price_..."
# Exposé au client Next.js — doit correspondre à STRIPE_PRICE_ID_PRO_MONTHLY
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO_MONTHLY="price_..."

# --- IA — Extraction documents fiscaux ---
# Clé API Google Gemini (console.cloud.google.com)
GEMINI_API_KEY="AIza..."

# --- Stockage de fichiers (Vercel Blob) ---
# Token d'accès au Blob Store Vercel (Settings > Blob dans le dashboard Vercel)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
